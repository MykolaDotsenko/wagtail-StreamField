# Development can run without these values.
# Production requires a strong secret. On Render, RENDER_EXTERNAL_HOSTNAME is
# injected by the platform and DomoNest derives the Render host, CSRF origin,
# and Wagtail admin base URL automatically.
#
# For custom domains, set the explicit values below.

DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
WAGTAILADMIN_BASE_URL=https://example.com

# PostgreSQL. If POSTGRES_DB is absent, development falls back to SQLite.
POSTGRES_DB=domonest
POSTGRES_USER=domonest
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# Release lifecycle. Render Free cannot use preDeployCommand, so the provided
# Blueprint runs migrations at process startup. On a paid Render service, move
# migrations to preDeployCommand and set this to false.
DOMONEST_RUN_MIGRATIONS_ON_START=true

# Optional portfolio demo reset. Never enable this for a real household account.
# The seed command always forces this account to be active, non-staff and
# non-superuser.
DOMONEST_AUTO_SEED_DEMO=false
DOMONEST_DEMO_USERNAME=demo
DOMONEST_DEMO_PASSWORD=replace-with-a-demo-only-password

# Filesystem media is valid only when DJANGO_MEDIA_ROOT points at durable
# storage. Render Free is ephemeral, so editor-uploaded Wagtail media should use
# the optional S3-compatible backend below.
DJANGO_MEDIA_ROOT=/var/lib/domonest/media

# Set AWS_STORAGE_BUCKET_NAME to activate S3-compatible Wagtail media storage.
# Works with AWS S3 and compatible providers such as Cloudflare R2 or Spaces.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_S3_CUSTOM_DOMAIN=
AWS_S3_PUBLIC_DOMAIN=
AWS_S3_ADDRESSING_STYLE=
AWS_QUERYSTRING_AUTH=true
AWS_S3_USE_SSL=true

# Set only when TLS is terminated by a trusted reverse proxy that overwrites
# X-Forwarded-Proto correctly. Render's managed proxy satisfies this contract.
DJANGO_TRUST_X_FORWARDED_PROTO=false

# HSTS rollout: start conservatively and increase only after HTTPS is proven
# across the intended domain/subdomain surface.
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false

# Gunicorn.
WEB_CONCURRENCY=2
GUNICORN_TIMEOUT=30
