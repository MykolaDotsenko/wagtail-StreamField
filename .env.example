# Development can run without these values.
# Production requires a strong secret, explicit hosts/origins and Wagtail admin URL.

DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
WAGTAILADMIN_BASE_URL=https://example.com

# PostgreSQL. If POSTGRES_DB is absent, development falls back to SQLite.
POSTGRES_DB=domonest
POSTGRES_USER=domonest
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# Use a persistent/shared path or replace the default media storage backend
# with provider-backed storage in real multi-instance deployments.
DJANGO_MEDIA_ROOT=/var/lib/domonest/media

# Set only when TLS is terminated by a trusted reverse proxy that sends
# X-Forwarded-Proto correctly.
DJANGO_TRUST_X_FORWARDED_PROTO=false

# HSTS rollout: start conservatively and increase only after HTTPS is proven
# across the intended domain/subdomain surface.
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
